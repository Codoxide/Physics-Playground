  m_FontData:
    m_Font: {fileID: 12800000, guid: 07c93279103e14170adb4473842e8378, type: 3}
    m_FontSize: 300
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 300
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.5
  m_Text: 'The tallest rollercoaster drops are designed using physics, not just height.
    The first hill is usually the highest because the coaster does not have an engine
    pulling it through the entire track. Instead, it relies on the gravitational
    potential energy gained at the top of the hill to power the rest of the ride.


    Some
    modern rollercoasters can reach speeds over 200 km/h, but engineers must carefully
    balance speed, forces, and safety to create an exciting ride without making the
    forces too extreme for passengers.'
